{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-downloader-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "FORMS_DB",
      "id": "8e066d676b6f4a588ab09da21408cb70"
    }
  ]
}
