{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-downloader-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
